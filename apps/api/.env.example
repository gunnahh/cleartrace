# ClearTrace API Server Environment Template
# Copy this file to .env and adjust values for your environment

# Database Configuration
# PostgreSQL connection string for Prisma ORM
# Format: postgresql://user:password@host:port/database?schema=public
# Local development: uses host.docker.internal when inside container
DATABASE_URL=postgresql://cleartrace:change-this-local-database-password@localhost:5432/cleartrace?schema=public

# JWT Authentication
# Minimum 32-character random string for signing JWT tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-at-least-32-random-characters

# Server Configuration
# Port on which the Fastify API server listens
PORT=3001

# Frontend Origin for CORS and cookie configuration
# Must match the URL where users access the web application
# Local development: http://localhost:5173 (Vite dev server)
# Docker: http://localhost:8080 (Nginx)
# Production: https://yourdomain.com
WEB_ORIGIN=http://localhost:5173
ADDITIONAL_WEB_ORIGINS=

# File Upload Storage
# Directory path for storing uploaded evidence files (screenshots, documents)
# Use absolute paths for Docker: /app/data/uploads
UPLOAD_DIR=./data/uploads

# File Upload Constraints
# Maximum file size in bytes (10 MB default)
# Must match WEB_ORIGIN constraints and CDN limits
MAX_UPLOAD_BYTES=10485760
