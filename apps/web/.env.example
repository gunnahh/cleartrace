# ClearTrace Frontend Environment Template
# Copy this file to .env and adjust values for your environment

# API Configuration
# Base URL for backend API calls
# Local development: use http://localhost:3001
# Docker: use /api (proxied through Nginx)
VITE_API_URL=http://localhost:3001

# Application Behavior
# Enable debug menu for development troubleshooting
# Only use during development; disable in production
VITE_ENABLE_DEBUG_MENU=false

# Use mock API adapter for component testing without backend
# Useful for isolated UI development or when backend is unavailable
VITE_ENABLE_MOCK_API=false

# Console Logging Level
# Options: silent, error, warn, info, debug, trace
# Use 'warn' or 'error' in production, 'debug' or 'trace' during development
VITE_LOG_LEVEL=warn

# Feature Flags
# Enable experimental or in-progress features for testing
VITE_FEATURE_AUDIT_LOG=false
VITE_FEATURE_BULK_OPERATIONS=false
VITE_FEATURE_EXPORT_PDF=false
