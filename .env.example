# Docker Compose
COMPOSE_PROJECT_NAME=cleartrace
POSTGRES_USER=cleartrace
POSTGRES_PASSWORD=change-this-local-database-password
POSTGRES_DB=cleartrace
JWT_SECRET=replace-with-at-least-32-random-characters
API_PORT=3001
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080
MAX_UPLOAD_BYTES=10485760

# The Docker web container calls the API through Nginx.
VITE_API_URL=/api
