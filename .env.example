# ClearTrace Full-Stack Environment Template
# Copy this file to .env and adjust values for your environment
# This file is used by Docker Compose and the API server

# Docker Compose
# Project name used as prefix for all container names and volumes
COMPOSE_PROJECT_NAME=cleartrace

# PostgreSQL Database Configuration
# Local development database credentials
POSTGRES_USER=cleartrace
POSTGRES_PASSWORD=change-this-local-database-password
POSTGRES_DB=cleartrace

# JWT Authentication
# Replace with a minimum 32-character random string for production
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-at-least-32-random-characters

# Application Ports
# API backend port (Fastify server)
API_PORT=3001

# Web application port (Nginx reverse proxy in Docker)
WEB_PORT=8080

# Frontend Origin for CORS and cookie configuration
# Must match the URL where users access the application
# Local development: http://localhost:8080
# Production: https://yourdomain.com
WEB_ORIGIN=http://localhost:8080
ADDITIONAL_WEB_ORIGINS=http://localhost:5173

# File Upload Configuration
# Maximum file size in bytes (10 MB default)
# Set lower limits for memory-constrained environments
MAX_UPLOAD_BYTES=10485760

# Frontend API URL
# Local development: uses direct backend URL
# Docker: uses /api path (proxied through Nginx)
VITE_API_URL=/api
